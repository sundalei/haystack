{# Managed by Ansible - do not edit by hand #}
server.host: "127.0.0.1"
server.port: {{ kibana_port }}
server.publicBaseUrl: "https://{{ kibana_domain }}"

elasticsearch.hosts: ["http://127.0.0.1:{{ es_http_port }}"]
elasticsearch.username: "kibana_system"
elasticsearch.password: "{{ vault_kibana_system_password }}"

xpack.encryptedSavedObjects.encryptionKey: "{{ vault_kibana_encryption_keys.encryptedSavedObjects }}"
xpack.reporting.encryptionKey: "{{ vault_kibana_encryption_keys.reporting }}"
xpack.security.encryptionKey: "{{ vault_kibana_encryption_keys.security }}"
